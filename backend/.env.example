PORT=4000
MONGO_URI=mongodb://localhost:27017/parkistics
ML_URL=http://localhost:8001
CORS_ORIGIN=*
# Google Maps — enables REAL parking dataset (Places API New), geocoding, and the Google map view.
# Restrict the key by HTTP referrer (browser) + IP (server). See docs/GOOGLE_MAPS_KEY.md
GOOGLE_MAPS_API_KEY=
# Optional: separate referrer-restricted key for the browser map view (falls back to GOOGLE_MAPS_API_KEY)
GOOGLE_MAPS_BROWSER_KEY=
